    "import numpy as np\n",
    "import math\n",
    "from scipy.optimize import curve_fit\n",
    "\n",
    "# Load data\n",
    "df = pd.read_csv('NGC4147_gaia_dr3_corrected_filtered_file.csv')\n",
    "df1 = pd.read_csv('NGC4147_cluster_stars.csv')\n",
    "df2 = pd.read_csv('NGC4147_extratidal_stars.csv')\n",
    "\n",
    "############################ GAUSSIAN FIT FOR EXTRA-TIDAL STARS ###################################\n",
    "\n",
    "# Extract proper motion data\n",
    "data_x = df2['pmra'].dropna()\n",
    "data_y = df2['pmdec'].dropna()\n",
    "\n",
    "# Histograms\n",
    "counts_x, bin_edges_x = np.histogram(data_x, bins=50, density=True)\n",
    "counts_y, bin_edges_y = np.histogram(data_y, bins=50, density=True)\n",
    "bin_centers_x = (bin_edges_x[:-1] + bin_edges_x[1:]) / 2\n",
    "bin_centers_y = (bin_edges_y[:-1] + bin_edges_y[1:]) / 2\n",
    "\n",
    "# Gaussian function\n",
    "def gaussian(x, mean, stddev, amplitude):\n",
    "    return amplitude * np.exp(-0.5 * ((x - mean) / stddev) ** 2)\n",
    "\n",
    "# Fit pmra\n",
    "initial_guess_x = [np.mean(data_x), np.std(data_x), np.max(counts_x)]\n",
    "params_x, _ = curve_fit(gaussian, bin_centers_x, counts_x, p0=initial_guess_x)\n",
    "mu_x, sigma_x, amplitude_x = params_x\n",
    "\n",
    "# Fit pmdec\n",
    "initial_guess_y = [np.mean(data_y), np.std(data_y), np.max(counts_y)]\n",
    "params_y, _ = curve_fit(gaussian, bin_centers_y, counts_y, p0=initial_guess_y)\n",
    "mu_y, sigma_y, amplitude_y = params_y\n",
    "\n",
    "# Plot pmra\n",
    "x_range = np.linspace(min(data_x), max(data_x), 1000)\n",
    "plt.plot(x_range, gaussian(x_range, *params_x), 'r-', label='Gaussian Fit')\n",
    "plt.xlabel('pmra')\n",
    "plt.ylabel('Probability Density')\n",
    "plt.title('Gaussian fit for pmra of field stars')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "print(f\"Mean_pmra: {mu_x}\")\n",
    "print(f\"Sigma_pmra: {sigma_x}\")\n",
    "\n",
    "# Plot pmdec\n",
    "y_range = np.linspace(min(data_y), max(data_y), 1000)\n",
    "plt.plot(y_range, gaussian(y_range, *params_y), 'r-', label='Gaussian Fit')\n",
    "plt.xlabel('pmdec')\n",
    "plt.ylabel('Probability Density')\n",
    "plt.title('Gaussian fit for pmdec of field stars')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "print(f\"Mean_pmdec: {mu_y}\")\n",
    "print(f\"Sigma_pmdec: {sigma_y}\")\n",
    "\n",
    "\n",
    "df['gm']=((df['pmra']-mu_x)*(df['pmdec']-mu_y))/(sigma_x*sigma_y)\n",
    "df1['gm']=((df1['pmra']-mu_x)*(df1['pmdec']-mu_y))/(sigma_x*sigma_y)\n",
    "df2['gm']=((df2['pmra']-mu_x)*(df2['pmdec']-mu_y))/(sigma_x*sigma_y)\n",
    "\n",
    "######################################## MEMBERSHIP PROBABILITY CALCULATION ########################################\n",
    "\n",
    "# Constants\n",
    "pi = math.pi\n",
    "N = len(df)\n",
    "n1 = len(df1)\n",
    "n2 = len(df2)\n",
    "sigma_v = 0.00000265723093  # pc/year\n",
    "R_sun = 19300  # kpc\n",
    "sigma_c = sigma_v / R_sun\n",
    "\n",
    "# Define probability density functions\n",
    "def Fc(n1, N, x, y, dx, dy, sigma_c, mu_xc=-1.71, mu_yc=-2.08):\n",
    "    return ((n1 / N) * (0.5 / pi) / np.sqrt((sigma_c**2 + dx**2)*(sigma_c**2 + dy**2)) *\n",
    "            np.exp(-0.5 * (((x - mu_xc)**2) / (sigma_c**2 + dx**2) + ((y - mu_yc)**2) / (sigma_c**2 + dy**2))))\n",
    "\n",
    "def Ff(n2, N, x, y, dx, dy, mu_x, mu_y, sigma_x, sigma_y, gm):\n",
    "    num = (x - mu_x)**2 / (sigma_x**2 + dx**2) \\\n",
    "        - 2 * gm * (x - mu_x) * (y - mu_y) / np.sqrt((sigma_x**2 + dx**2) * (sigma_y**2 + dy**2)) \\\n",
    "        + (y - mu_y)**2 / (sigma_y**2 + dy**2)\n",
    "    denom = (2 * pi * np.sqrt(1 - gm**2) *\n",
    "             np.sqrt((sigma_x**2 + dx**2) * (sigma_y**2 + dy**2)))\n",
    "    return (n2 / N) * (1 / denom) * np.exp(-0.5 * num / (1 - gm**2))\n",
    "\n",
    "def F(n1, n2, N, x, y, dx, dy, sigma_c, mu_x, mu_y, sigma_x, sigma_y, gm):\n",
    "    return Fc(n1, N, x, y, dx, dy, sigma_c) + Ff(n2, N, x, y, dx, dy, mu_x, mu_y, sigma_x, sigma_y, gm)\n",
    "\n",
    "# Calculate membership probabilities\n",
    "df['Mem_Prob'] = Fc(n1, N, df['pmra'], df['pmdec'], df['pmra_error'], df['pmdec_error'], sigma_c) / \\\n",
    "                 F(n1, n2, N, df['pmra'], df['pmdec'], df['pmra_error'], df['pmdec_error'], sigma_c, mu_x, mu_y, sigma_x, sigma_y, df['gm'])\n",
    "\n",
    "df1['Mem_Prob'] = Fc(n1, N, df1['pmra'], df1['pmdec'], df1['pmra_error'], df1['pmdec_error'], sigma_c) / \\\n",
    "                  F(n1, n2, N, df1['pmra'], df1['pmdec'], df1['pmra_error'], df1['pmdec_error'], sigma_c, mu_x, mu_y, sigma_x, sigma_y, df1['gm'])\n",
    "\n",
    "df2['Mem_Prob'] = Fc(n1, N, df2['pmra'], df2['pmdec'], df2['pmra_error'], df2['pmdec_error'], sigma_c) / \\\n",
    "                  F(n1, n2, N, df2['pmra'], df2['pmdec'], df2['pmra_error'], df2['pmdec_error'], sigma_c, mu_x, mu_y, sigma_x, sigma_y, df2['gm'])\n",
