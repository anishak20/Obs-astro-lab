   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "INFO: Query finished. [astroquery.utils.tap.core]\n",
      "Download complete. Data saved as 'NGC4147_gaia_dr3.csv'.\n"
